# Copia este archivo a .env en la raíz del repo y completa los valores reales.
# Nunca commitees .env con valores reales — ver .gitignore.

# --- API ---
APP_ENV=development                 # development | staging | production
PORT=8080
DATABASE_URL=postgres://pawfound:pawfound@localhost:5432/pawfound?sslmode=disable
# Genera uno con: openssl rand -base64 48 (mínimo 32 caracteres). Distinto por entorno.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
PUBLIC_API_URL=http://localhost:8080   # https obligatorio fuera de development
PUBLIC_WEB_URL=https://pawfound.pages.dev
MEDIA_DIR=./data/media
MIGRATE_ON_START=                   # por defecto: true en development, false en el resto
JOBS_ENABLED=true
JOBS_INTERVAL=10m
# Cabecera con la IP real que pone el proxy de confianza (p. ej. CF-Connecting-IP). Vacío =
# IP de la conexión. Nunca X-Forwarded-For sin un proxy que la controle.
CLIENT_IP_HEADER=
# Solo development: código de verificación fijo para probar la app contra la API local.
DEV_FIXED_CODE=

# --- Login social: la app no lo ofrece (decisión del 2026-11-01). Vacío = desactivado ---
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# --- Proveedores (cada uno tras su evaluación en docs/legal/incidentes-y-proveedores.md) ---
# Correo (verificación y restablecimiento). Vacío: en development se escribe en el log.
# Correo por la API web de Brevo (HTTPS). Úsala en hostings que bloquean SMTP, como el plan
# gratis de Render. Tiene prioridad sobre SMTP_*; el remitente sigue siendo SMTP_FROM.
BREVO_API_KEY=
# Correos que reciben el rol de administrador del panel /admin al verificar su cuenta.
ADMIN_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PUSH_PROVIDER=                      # log (solo development) | none | expo
EXPO_ACCESS_TOKEN=                  # opcional: solo si el proyecto de Expo exige token para enviar push

CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=               # vacío = las fotos se guardan en MEDIA_DIR

# Errores (Sentry). Vacío = no se envía nada.
SENTRY_DSN=

# Verificación de refugios con el RUES (datos abiertos de datos.gov.co). No hace falta configurar
# nada; el token solo sube el límite de consultas.
RUES_URL=
RUES_APP_TOKEN=

# Importador de veterinarias (api import-places). Vacío = API pública de Overpass.
OVERPASS_URL=
