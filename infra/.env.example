# Copia este archivo a .env en la raíz del repo y completa los valores reales.
# Nunca commitees .env con valores reales — ver .gitignore.

# --- API ---
APP_ENV=development                 # development | staging | production
PORT=8080
DATABASE_URL=postgres://pawfound:pawfound@localhost:5432/pawfound?sslmode=disable
# Genera uno con: openssl rand -base64 48 (mínimo 32 caracteres). Distinto por entorno.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
PUBLIC_API_URL=http://localhost:8080   # https obligatorio fuera de development
PUBLIC_WEB_URL=https://pawfound.app
MEDIA_DIR=./data/media
MIGRATE_ON_START=                   # por defecto: true en development, false en el resto
JOBS_ENABLED=true
JOBS_INTERVAL=1m
# Cabecera con la IP real que pone el proxy de confianza (p. ej. CF-Connecting-IP). Vacío =
# IP de la conexión. Nunca X-Forwarded-For sin un proxy que la controle.
CLIENT_IP_HEADER=
# Solo development: código SMS fijo para probar la app contra la API local.
DEV_FIXED_SMS_CODE=

# --- Login social (client IDs de la app, separados por coma; vacío = desactivado) ---
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# --- Proveedores (dejar vacío hasta completar la evaluación de seguridad/privacidad) ---
SMS_PROVIDER=                       # log (solo development) | none
PUSH_PROVIDER=                      # log (solo development) | none | expo
EXPO_ACCESS_TOKEN=

CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

SENTRY_DSN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
