---
/**
 * Botones de tienda. La app todavía no está publicada: no enlazan a fichas que no existen.
 * Al publicar, se reemplazan por las insignias oficiales de Google Play y App Store (cada
 * tienda exige su arte oficial) con el enlace a la ficha.
 */
---

<div class="stores" aria-label="Descarga PawFound">
  <div class="store" role="img" aria-label="Muy pronto en Google Play para Android">
    <span class="soon">Muy pronto</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#34d399" d="M4 3.5v17a1 1 0 0 0 1.5.86L19 13.7a1.9 1.9 0 0 0 0-3.4L5.5 2.64A1 1 0 0 0 4 3.5Z"></path></svg>
    <span><small>MUY PRONTO EN</small><strong>Google Play</strong></span>
  </div>
  <div class="store" role="img" aria-label="Más adelante en App Store para iPhone">
    <span class="soon">Más adelante</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="3" fill="none" stroke="#fff" stroke-width="1.8"></rect><circle cx="12" cy="18.2" r="1" fill="#fff"></circle></svg>
    <span><small>MÁS ADELANTE EN</small><strong>App Store</strong></span>
  </div>
</div>
