---
import Base from "../layouts/Base.astro";

// Destino del enlace del correo "Restablecer contraseña" (pawfound.pages.dev/restablecer?token=…).
// La página no guarda nada: envía la nueva contraseña a la API, que acepta esta página por CORS.
const api = (import.meta.env.PUBLIC_API_URL || "https://pawfound-api.onrender.com").replace(/\/+$/, "");
---

<Base title="Nueva contraseña · PawFound" description="Elige una nueva contraseña para tu cuenta de PawFound." isPrivate>
  <section class="page-hero">
    <div class="wrap">
      <h1>Elige una nueva contraseña</h1>
      <p>Después vuelve a la app e inicia sesión con ella. Por seguridad, se cerrarán las sesiones abiertas en otros celulares.</p>
    </div>
  </section>
  <section class="reset-wrap">
    <div class="wrap">
      <form class="card reset" id="reset-form" data-api={api} novalidate>
        <label for="password">Nueva contraseña</label>
        <div class="field">
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="256" required />
          <button type="button" class="toggle" id="toggle" aria-controls="password" aria-pressed="false">Ver</button>
        </div>
        <ul class="rules" id="rules" aria-live="polite">
          <li data-rule="length">Al menos 8 caracteres</li>
          <li data-rule="upper">Una letra mayúscula</li>
          <li data-rule="lower">Una letra minúscula</li>
          <li data-rule="number">Un número</li>
        </ul>
        <label for="confirm">Repite la contraseña</label>
        <input id="confirm" name="confirm" type="password" autocomplete="new-password" maxlength="256" required />
        <p class="message" id="message" role="status" aria-live="polite"></p>
        <button type="submit" class="btn btn-primary" id="submit">Guardar contraseña</button>
      </form>
      <div class="card reset done" id="done" hidden>
        <h2>¡Listo! Tu contraseña cambió</h2>
        <p>Abre PawFound e inicia sesión con tu nueva contraseña.</p>
        <a class="btn btn-primary" href="pawfound://auth/login">Abrir PawFound</a>
      </div>
    </div>
  </section>

  <style>
    .reset-wrap { padding: 2.5rem 0 4rem; }
    /* .card usa display: grid, que le gana al atributo hidden. */
    .reset[hidden] { display: none; }
    .reset { max-width: 30rem; margin: 0 auto; gap: 0.5rem; }
    .reset label { font-weight: 800; color: var(--ink); margin-top: 0.4rem; }
    .reset input { font: inherit; width: 100%; min-height: 48px; padding: 0.7rem 0.9rem; border: 1.5px solid var(--border); border-radius: 14px; background: var(--surface); color: var(--ink); }
    .reset input:focus { outline: 3px solid var(--teal-soft); border-color: var(--teal); }
    .field { position: relative; }
    .field input { padding-right: 4.5rem; }
    .toggle { position: absolute; right: 0.4rem; top: 50%; transform: translateY(-50%); font: inherit; font-weight: 800; color: var(--teal); background: var(--teal-soft); border: 0; border-radius: 999px; padding: 0.4rem 0.8rem; cursor: pointer; }
    .rules { list-style: none; margin: 0.2rem 0 0.4rem; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem 0.8rem; font-size: 0.9rem; color: var(--muted); }
    .rules li::before { content: "○ "; }
    .rules li.ok { color: var(--teal); }
    .rules li.ok::before { content: "✓ "; }
    .message { min-height: 1.4rem; margin: 0.3rem 0 0; font-weight: 700; }
    .message.error { color: var(--lost); }
    .message.info { color: var(--muted); }
    .reset .btn { width: 100%; margin-top: 0.3rem; }
    .reset .btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .done { text-align: center; justify-items: center; }
    .done .btn { width: auto; }
  </style>

  <script is:inline src="/restablecer.js"></script>
</Base>
