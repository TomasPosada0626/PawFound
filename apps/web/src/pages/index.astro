---
import Icon, { type IconName } from "../components/Icon.astro";
import StoreButtons from "../components/StoreButtons.astro";
import Base from "../layouts/Base.astro";

// Radios calculados con la fórmula del producto (lifecircle): 250 m + 2475 m × √horas, con tope de 2 km.
// Es igual para toda mascota perdida.
const radii = [
  { when: "Al publicar", radius: "250 m" },
  { when: "5 minutos", radius: "960 m" },
  { when: "15 minutos", radius: "1,5 km" },
  { when: "30 minutos", radius: "2 km" },
];

// Avisos con los textos que usa la app (i18n/es.ts › notifications). Los nombres son de ejemplo.
const notifications = [
  { title: "🚨 Alerta Ángel", body: "Una mascota se perdió cerca de ti: Max. Ayuda a encontrarla.", time: "ahora" },
  { title: "🚨 Se perdió la mascota de Ana", body: "Ayuda a Ana a buscar a Luna.", time: "5 min" },
  { title: "🐾 Encontraron una mascota cerca de ti", body: "Una perrita está cerca de ti. ¿Sabes de quién es?", time: "20 min" },
  { title: "🎉 ¡Buenas noticias de Ana!", body: "Luna ya está en casa.", time: "1 h" },
];

const features: { icon: IconName; tone: string; title: string; text: string }[] = [
  { icon: "bell", tone: "i-lost", title: "Alerta Ángel", text: "Si se pierde una mascota a menos de 250 m de donde estás, te llega al instante. Si estás más lejos, te llega cuando su círculo de búsqueda crece hasta ti. Máximo 5 al día." },
  { icon: "found", tone: "i-teal", title: "Encontradas cerca de ti", text: "Cuando alguien reporta una mascota que encontró, avisamos a los celulares cercanos: quizá sabes de quién es." },
  { icon: "users", tone: "i-violet", title: "Tus amigos se enteran", text: "Si se pierde tu mascota, quienes te siguen reciben un aviso, y otro cuando vuelve a casa. Si están cerca, les llega la Alerta Ángel en su lugar: nunca dos avisos por lo mismo." },
  { icon: "stories", tone: "i-violet", title: "Historias que no vencen", text: "Cada caso tiene su historia con fotos y novedades de la familia. No se borra a las 24 horas: sigue ahí hasta que la mascota vuelve a casa." },
  { icon: "chat", tone: "i-teal", title: "Chats con fotos y ubicación", text: "Un grupo por caso y mensajes directos con la familia. Envía la foto de lo que viste y, si quieres, dónde estás o un punto de encuentro: se deja de ver cuando el chat se cierra." },
  { icon: "heart", tone: "i-gold", title: "¿Es tu mascota?", text: "Registra a tus mascotas antes de que pase algo. Si alguien encuentra una parecida cerca de tu zona, te avisamos para que revises las fotos." },
  { icon: "qr", tone: "i-blue", title: "Afiche con QR", text: "Crea en segundos un afiche para imprimir o enviar por WhatsApp. El QR abre el caso, y tu celular solo aparece si decides agregarlo." },
  { icon: "vet", tone: "i-teal", title: "¿Está herida? Veterinaria ya", text: "Al reportar una mascota encontrada te mostramos las veterinarias más cercanas. Eliges una y «Vamos» abre la ruta en Waze o Google Maps." },
];

const tutorial = [
  { title: "Crea tu cuenta", text: "Correo, nombre y apellidos, un nombre de usuario y una contraseña segura. Te enviamos un código de 6 dígitos (revisa también la carpeta de spam): al escribirlo ganas tu primera insignia, «Protector verificado»." },
  { title: "Activa las Alertas Ángel", text: "Permite las notificaciones y «Alertas donde estés». Te avisamos de mascotas perdidas y encontradas cerca de ti, máximo 5 Alertas Ángel al día, y puedes silenciarlas en tu horario de descanso." },
  { title: "Agrega a tus mascotas", text: "En «Mis mascotas» guarda su foto, señas y collar. Si un día se pierde, el reporte sale con un toque, y si alguien encuentra una parecida te avisamos." },
  { title: "Conecta con tu gente", text: "Busca a tus amigos por su nombre de usuario (con o sin @) y envíales una solicitud. Al aceptarla se siguen mutuamente: si se pierde una mascota de tu red, te enteras." },
  { title: "Si se pierde: publica de inmediato", text: "Toca «Se perdió», confirma dónde y cuándo la viste por última vez y publica. Las primeras horas son las que más cuentan: el aviso sale a los vecinos que están cerca y a quienes te siguen." },
  { title: "Si encuentras una: repórtala", text: "Toma una foto, marca dónde la encontraste y cuéntanos cómo está. Avisamos a quienes están cerca. Si está herida, «Busquemos la veterinaria más cercana» te lleva con Waze o Google Maps; allí también leen su microchip." },
  { title: "Ayuda, comparte y agradece", text: "Toca «La vi» si la ves, únete al grupo del caso y comparte la historia o el afiche. Cuando vuelva a casa, quien abrió el caso lo cierra y califica con estrellas a quienes ayudaron." },
];

const faqs = [
  { q: "¿PawFound es gratis?", a: "Sí, completamente: sin pagos, sin suscripciones y sin publicidad. Las Alertas Ángel llegan como notificación de la app, no como SMS, y la adopción en PawFamily también es 100 % gratuita." },
  { q: "¿Alguien puede ver dónde vivo o dónde estoy?", a: "No. Nadie ve la ubicación de otra persona. Los reportes y avistamientos se muestran aproximados a 250 m y nunca con tu dirección. Solo tú decides compartir en un chat dónde estás o un punto de encuentro, y deja de verse cuando ese chat se cierra." },
  { q: "¿Quién ve mis mascotas y mi perfil?", a: "Cualquiera ve tu nombre, tus insignias, tus estrellas y cuántos seguidores tienes. Tus mascotas registradas solo las ven las personas que te siguen, y la lista de a quién sigues y quién te sigue solo la ves tú." },
  { q: "¿Qué pasa si alguien me pide dinero?", a: "Nunca pagues por adelantado para recuperar una mascota, y en PawFamily nadie puede cobrar por adoptar. Repórtalo desde la app: moderación lo revisa y puede vetar la cuenta." },
  { q: "¿Puedo eliminar mi cuenta?", a: "Sí, desde tu perfil o en Ajustes › Privacidad. Se borra todo: tu perfil, tus reportes, tus publicaciones de PawFamily, tus mensajes, tu red y tus fotos. Te pedimos escribir ELIMINAR para confirmar, porque no se puede deshacer." },
  { q: "¿Cuándo sale para iPhone?", a: "Primero lanzamos en Android para el Valle de Aburrá. La versión para iPhone llega después y funcionará igual." },
];
---

<Base
  title="PawFound · Que ninguna mascota se quede sin volver a casa"
  description="PawFound avisa a los vecinos que están cerca cuando una mascota se pierde o aparece, y amplía la búsqueda con las horas. Con PawFamily, la adopción 100 % gratuita. Para el Valle de Aburrá."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div>
        <p class="eyebrow"><Icon name="paw" /> Lanzamiento en el Valle de Aburrá</p>
        <h1 id="hero-title" style="margin-top:1rem">Que ninguna mascota se quede <em>sin volver a casa.</em></h1>
        <p class="lead">
          Cuando una mascota se pierde, PawFound avisa al instante a los vecinos que están cerca y, a medida que pasan las horas, amplía la
          búsqueda a más personas. Tú publicas en un minuto; la comunidad hace el resto. Y si buscas un nuevo integrante para tu familia,
          PawFamily te conecta con mascotas en adopción, sin costo.
        </p>
        <div class="badges-row">
          <span class="pill">🚨 Alerta Ángel</span>
          <span class="pill">⭕ Círculo de vida</span>
          <span class="pill">💬 Grupo por caso</span>
          <span class="pill">🏡 PawFamily</span>
          <span class="pill">🔒 Sin dirección exacta</span>
        </div>
        <div id="descargar"><StoreButtons /></div>
        <p class="hero-note">Gratis y sin publicidad. Primero en Android; en iPhone, más adelante.</p>
      </div>
      <div class="stage" role="img" aria-label="Celular con avisos de PawFound: una Alerta Ángel, la mascota perdida de una amiga, una mascota encontrada cerca y un reencuentro">
        <span class="ring"></span><span class="ring"></span><span class="ring"></span>
        <div class="phone">
          <div class="screen">
            <p class="lock-time">9:41</p>
            <p class="lock-sub">Notificaciones</p>
            {notifications.map((n) => (
              <div class="notif">
                <img src="/logo.png" alt="" width="26" height="26" />
                <div>
                  <p class="n-head"><span>PawFound</span><span>{n.time}</span></p>
                  <strong>{n.title}</strong>
                  <span>{n.body}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="como-funciona" aria-labelledby="como-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Cómo funciona</p>
        <h2 id="como-title">Tres pasos entre «se perdió» y «ya está en casa»</h2>
        <p class="lead">Ningún grupo de WhatsApp llega a tantas personas a la vez, en el lugar correcto y en el momento justo.</p>
      </div>
      <div class="steps">
        <article class="card step lost">
          <h3>Publicas en un minuto</h3>
          <p>Foto, señas y el último lugar donde la viste. Si la tenías en «Mis mascotas», el reporte ya está lleno.</p>
        </article>
        <article class="card step">
          <h3>Avisamos a quien está cerca</h3>
          <p>Le llega la Alerta Ángel a quienes están dentro de su círculo de vida, a más personas a medida que el círculo crece y a quienes te siguen.</p>
        </article>
        <article class="card step violet">
          <h3>La comunidad la encuentra</h3>
          <p>Avistamientos con «La vi», el grupo del caso, la historia y el afiche compartidos. Al reencontrarse, la familia cierra el caso y agradece.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band-dark" id="circulo" aria-labelledby="circulo-title">
    <div class="wrap life">
      <div class="life-visual" aria-hidden="true">
        <span class="ring"></span><span class="ring"></span><span class="ring"></span>
        <span class="pin"><Icon name="paw" /></span>
        <span class="you">Tú</span>
      </div>
      <div>
        <p class="eyebrow" style="color:#7fe0cb">El círculo de vida</p>
        <h2 id="circulo-title" style="margin-top:0.6rem">La búsqueda crece al ritmo de la mascota</h2>
        <p class="lead" style="color:#b6c8d2;margin:1rem 0 1.5rem">
          Cada búsqueda arranca a 250 m del último lugar donde la vieron y en unos 30 minutos llega a 2 km: las primeras horas son las que
          más cuentan. Cuando el círculo llega a donde estás, te avisamos. Un nuevo avistamiento lo vuelve a centrar.
        </p>
        <dl class="radii">
          {radii.map((r) => <div><dt>{r.when}</dt><dd>{r.radius}</dd></div>)}
        </dl>
        <p style="margin-top:0.9rem;font-size:0.9rem">Radios aproximados, iguales para toda mascota perdida. Si estás a menos de 250 m del reporte, la alerta te llega de inmediato.</p>
      </div>
    </div>
  </section>

  <section class="section" id="funciones" aria-labelledby="funciones-title">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">Todo lo que necesitas</p>
        <h2 id="funciones-title">Hecha para encontrar, no para scrollear</h2>
      </div>
      <div class="grid grid-4">
        {features.map((f) => (
          <article class="card">
            <span class={`icon ${f.tone}`}><Icon name={f.icon} /></span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-family" id="pawfamily" aria-labelledby="pawfamily-title">
    <div class="wrap family">
      <div style="display:grid;gap:1.25rem">
        <p class="family-mark"><img src="/logo.png" alt="" width="38" height="38" /><span>Paw<b>Family</b><small>de PawFound</small></span></p>
        <p class="eyebrow">Adopción responsable</p>
        <h2 id="pawfamily-title">¿Buscas un nuevo miembro para tu familia? ¿O una familia para un peludito?</h2>
        <p class="lead">
          PawFamily es la sección de PawFound para encontrarle hogar a mascotas abandonadas o de refugios. La encuentras en Inicio: aceptas las
          políticas de adopción responsable una vez y eliges cómo la vas a usar.
        </p>
        <p class="free-note"><Icon name="shield" /> La adopción es 100 % gratuita. Nadie puede pedir ni recibir dinero, ni siquiera «para la vacuna» o «para el transporte». Si te lo piden, repórtalo: moderación lo revisa y puede vetar la cuenta.</p>
        <div class="grid grid-2">
          <article class="card">
            <span class="icon i-coral"><Icon name="family" /></span>
            <h3>Soy persona natural</h3>
            <p>Busca una mascota para adoptar, envía tu solicitud o da en adopción la tuya. Al adoptar ganas la insignia «Nuevo integrante».</p>
          </article>
          <article class="card">
            <span class="icon i-teal"><Icon name="shield" /></span>
            <h3>Soy refugio o fundación</h3>
            <p>Escribe el NIT con su dígito de verificación: si es válido según la DIAN, tu refugio queda verificado al instante y tienes tu panel de publicaciones y solicitudes.</p>
          </article>
        </div>
        <ul class="checks">
          <li><span><strong>Publica con fotos de verdad:</strong> de 1 a 5, con sexo, edad, tamaño, vacunas y esterilización. La dirección solo la ve la persona que aceptes.</span></li>
          <li><span><strong>Filtra a tu medida:</strong> distancia de 2 a 100 km o toda tu ciudad, animal, sexo, tamaño y edad, cada uno por separado.</span></li>
          <li><span><strong>Solicitud con informe:</strong> nombre, cuántas personas viven en tu casa, barrio y ciudad, si has tenido mascotas y por qué quieres adoptar.</span></li>
          <li><span><strong>Quien publica decide:</strong> le avisamos en la app y por correo (revisa la carpeta de spam). Al aceptar, se abre un chat para coordinar la entrega.</span></li>
        </ul>
      </div>
      <div class="family-aside" aria-label="Ejemplo de cómo se ve PawFamily en la app">
        <div class="filters" aria-hidden="true">
          <div><p>Distancia</p><div class="chips"><span class="chip">2 km</span><span class="chip on">5 km</span><span class="chip">10 km</span><span class="chip">25 km</span><span class="chip">Toda Medellín</span></div></div>
          <div><p>Animal</p><div class="chips"><span class="chip">Todos</span><span class="chip on">Perro</span><span class="chip">Gato</span><span class="chip">Otro</span></div></div>
          <div><p>Sexo · Tamaño · Edad</p><div class="chips"><span class="chip on">Hembra</span><span class="chip">Pequeño</span><span class="chip on">Mediano</span><span class="chip on">Joven</span></div></div>
        </div>
        <article class="adopt-card" aria-hidden="true">
          <div class="adopt-top">
            <div class="adopt-photo"><Icon name="paw" /></div>
            <div class="adopt-info">
              <h3>Canela</h3>
              <p class="meta">Perro · Criolla</p>
              <div class="chips"><span class="chip">Hembra</span><span class="chip">Joven</span><span class="chip">Mediano</span></div>
              <p class="meta teal">Vacunas al día · Esterilizada</p>
              <p class="meta">2,1 km · Laureles</p>
            </div>
          </div>
          <span class="tag"><Icon name="shield" /> Refugio verificado</span>
        </article>
        <p class="mock-label">Ejemplo ilustrativo de una publicación.</p>
      </div>
    </div>
  </section>

  <section class="section" id="comunidad" aria-labelledby="comunidad-title" style="background:var(--surface)">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Comunidad</p>
        <h2 id="comunidad-title">Tu red, tus estrellas y tus insignias</h2>
        <p class="lead">En PawFound la reputación se gana ayudando. Nada se compra y nada se infla.</p>
      </div>
      <div class="grid grid-3">
        <article class="card">
          <span class="icon i-violet"><Icon name="users" /></span>
          <h3>Seguidores, a tu manera</h3>
          <p>Busca personas por su nombre de usuario y envía una solicitud: al aceptarla se siguen mutuamente. Después, cada quien puede dejar de seguir o quitar un seguidor. Tres rechazos pausan las solicitudes a esa persona por 30 días.</p>
        </article>
        <article class="card">
          <span class="icon i-gold"><Icon name="star" /></span>
          <h3>Estrellas por ayudar</h3>
          <p><span class="stars" aria-hidden="true">★★★★★</span><br />Al cerrar su caso, la familia califica de 1 a 5 estrellas a quienes ayudaron. Tu promedio se ve desde la décima calificación, para que una sola nota no defina a nadie, y cuenta las 20 más recientes.</p>
        </article>
        <article class="card">
          <span class="icon i-lost"><Icon name="heart" /></span>
          <h3>Me gusta libres</h3>
          <p>Puedes darle me gusta al perfil de cualquier persona, la sigas o no, uno por persona. Si dejas de seguir a alguien, tu me gusta se queda.</p>
        </article>
      </div>
      <div class="grid grid-2" style="margin-top:1rem">
        <article class="card">
          <h3>Insignias que mejoran contigo</h3>
          <p>Se ganan con lo que pasa de verdad en los casos: reportar, encontrar, ver una mascota («Ojos atentos»), responder en la primera hora («Respuesta rápida»), compartir, unirte a grupos y que una familia te agradezca («Ángel de patas»). Cada nivel se ve distinto y mejor:</p>
          <div class="tiers" aria-label="Niveles de las insignias">
            <span class="tier"><span class="medal m-bronze"><Icon name="star" /></span>Bronce</span>
            <span class="tier"><span class="medal m-silver"><Icon name="star" /></span>Plata</span>
            <span class="tier"><span class="medal m-gold"><Icon name="star" /></span>Oro</span>
            <span class="tier"><span class="medal m-legend"><Icon name="star" /></span>Leyenda</span>
          </div>
          <p><strong>Popular</strong> sube con los me gusta: 50, 100, 250, 500 y Leyenda en 1.000. <strong>Protector animal</strong> llega desde tu décima calificación si tu promedio es mayor a 4,5; se pierde si bajas y se recupera si vuelves a subir. <strong>Nuevo integrante</strong> es para quien adopta en PawFamily.</p>
        </article>
        <article class="card">
          <h3>Tu privacidad en el perfil</h3>
          <ul class="checks">
            <li><span>Los demás ven tus insignias, tus estrellas y cuántos seguidores y seguidos tienes; las listas solo las ves tú.</span></li>
            <li><span>Tus mascotas registradas solo las ven las personas que te siguen.</span></li>
            <li><span>Nadie ve tu ciudad, tu barrio ni tu ubicación.</span></li>
          </ul>
          <h3 style="margin-top:0.8rem">El impacto de tu ciudad</h3>
          <p>En Inicio ves cuántas mascotas volvieron a casa en tu ciudad, los reportes del mes, los casos activos y cuántos se resolvieron en 14 días. Se calcula con casos reales: mientras haya pocos, no mostramos cifras.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="tutorial" aria-labelledby="tutorial-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Tutorial</p>
        <h2 id="tutorial-title">Tu primera vez en PawFound</h2>
        <p class="lead">Siete pasos, cinco minutos. Lo ideal es hacerlo hoy, antes de necesitarlo.</p>
      </div>
      <ol class="timeline">
        {tutorial.map((s, i) => (
          <li>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </li>
        ))}
      </ol>
      <p style="margin-top:1.5rem"><a class="btn btn-ghost" href="/guia">Ver la guía completa →</a></p>
    </div>
  </section>

  <section class="section" id="seguridad" aria-labelledby="seguridad-title" style="background:var(--surface)">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Seguridad y convivencia</p>
        <h2 id="seguridad-title">Una comunidad en la que se puede confiar</h2>
      </div>
      <div class="grid grid-3">
        <article class="card"><span class="icon i-teal"><Icon name="shield" /></span><h3>Cuentas verificadas</h3><p>Para publicar o escribir hay que verificar el correo. Cada cuenta publica máximo 2 reportes al día.</p></article>
        <article class="card"><span class="icon i-lost"><Icon name="search" /></span><h3>Contra las estafas</h3><p>Detectamos fotos copiadas de otras publicaciones. Nunca pagues por adelantado para recuperar a tu mascota, y en PawFamily nadie cobra por adoptar.</p></article>
        <article class="card"><span class="icon i-violet"><Icon name="chat" /></span><h3>Sin bloqueos, con moderación</h3><p>Si alguien es grosero o intenta estafar, lo reportas y una persona del equipo decide, con sanciones escalonadas hasta el veto.</p></article>
        <article class="card"><span class="icon i-blue"><Icon name="lock" /></span><h3>Tu ubicación, protegida</h3><p>Nadie ve tu ubicación ni tu dirección: todo se muestra aproximado a 250 m. Para las alertas guardamos solo tu último punto, sin historial, y se borra a los 30 días o al cerrar sesión.</p></article>
        <article class="card"><span class="icon i-gold"><Icon name="doc" /></span><h3>Casos y chats en orden</h3><p>Solo quien abre un caso puede cerrarlo. Al cerrarlo se cierran su grupo y sus mensajes directos; un mensaje directo también lo puede cerrar cualquiera de las dos personas.</p></article>
        <article class="card danger-card"><span class="icon i-lost"><Icon name="trash" /></span><h3>Tu cuenta, tu decisión</h3><p>Puedes eliminar tu cuenta desde tu perfil: se borra todo lo que publicaste. <a href="/eliminar-cuenta">Cómo eliminar tu cuenta</a>.</p></article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 id="faq-title">Lo que más nos preguntan</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
      <p style="margin-top:1.5rem"><a class="btn btn-ghost" href="/ayuda">Todas las preguntas y ayuda →</a></p>
    </div>
  </section>

  <section class="section band-teal" aria-labelledby="cta-title">
    <div class="wrap center" style="display:grid;gap:1.25rem;justify-items:center">
      <h2 id="cta-title">Prepárate hoy. Ayuda mañana.</h2>
      <p class="lead center" style="color:#d8f1eb">Descarga PawFound cuando salga, agrega a tus mascotas, conecta con tu gente y activa las alertas. Así, el día que alguien las necesite, estarás ahí.</p>
      <StoreButtons />
    </div>
  </section>
</Base>
