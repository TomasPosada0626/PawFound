---
import { Image } from "astro:assets";

import alerta from "../assets/alerta.png";
import caso from "../assets/caso.png";
import home from "../assets/home.png";
import mapa from "../assets/mapa.png";
import Icon from "../components/Icon.astro";
import StoreButtons from "../components/StoreButtons.astro";
import Base from "../layouts/Base.astro";

// Radios calculados con la fórmula del producto (PRODUCT.md): inicial + tasa × √horas, con tope.
const profiles = [{ name: "Toda mascota perdida", start: "250 m", six: "960 m", day: "1,5 km", cap: "2 km" }];

const features = [
  { icon: "bell", tone: "i-lost", title: "Alerta Ángel", text: "Si se pierde una mascota a menos de 250 m de donde estás, te llega al instante. Si estás más lejos, te llega cuando su círculo de búsqueda crece hasta ti." },
  { icon: "stories", tone: "i-violet", title: "Historias que no vencen", text: "Cada caso tiene su historia con fotos y novedades de la familia. No se borra a las 24 horas: sigue ahí hasta que la mascota vuelve a casa." },
  { icon: "chat", tone: "i-teal", title: "Chats con fotos y ubicación", text: "Un grupo por caso para coordinar la búsqueda y mensajes directos con la familia. Envía la foto de lo que viste y, por mensaje directo, tu ubicación o un punto de encuentro para entregarla." },
  { icon: "heart", tone: "i-gold", title: "¿Es tu mascota?", text: "Registra a tus mascotas antes de que pase algo. Si alguien encuentra una que se parece, te preguntamos al instante." },
  { icon: "qr", tone: "i-blue", title: "Afiche con QR", text: "Crea en segundos un afiche para imprimir o enviar por WhatsApp. Sin números de teléfono: el QR abre el caso." },
  { icon: "vet", tone: "i-teal", title: "¿Está herida? Veterinaria ya", text: "Al reportar una mascota encontrada, te mostramos las veterinarias más cercanas. Eliges una y «Vamos» abre la ruta en Waze o Google Maps." },
  { icon: "star", tone: "i-gold", title: "Insignias de verdad", text: "Se ganan ayudando: avistamientos, reencuentros, casos compartidos. Nunca se compran. La familia elige a quién agradecer." },
  { icon: "lock", tone: "i-violet", title: "Tu ubicación, protegida", text: "Nadie ve tu dirección: todo se muestra aproximado a 250 m. Para las alertas guardamos solo tu último punto, sin historial." },
];

const tutorial = [
  { title: "Crea tu cuenta", text: "Correo, nombre y apellidos, un nombre de usuario y una contraseña segura. Te enviamos un código de 6 dígitos: al escribirlo ganas tu primera insignia, «Protector verificado»." },
  { title: "Activa las Alertas Ángel", text: "Permite las notificaciones y «Alertas donde estés». Te avisamos solo de mascotas perdidas cerca de ti, máximo 5 al día, y sin sonido en tu horario de descanso." },
  { title: "Agrega a tus mascotas", text: "En «Mis mascotas» guarda su foto, señas y collar. Si un día se pierde, el reporte sale con un toque, y si alguien encuentra una parecida te avisamos." },
  { title: "Si se pierde: publica de inmediato", text: "Toca «Se perdió», confirma dónde y cuándo la viste por última vez y publica. Las primeras horas son las que más cuentan: el aviso sale a los vecinos que están cerca." },
  { title: "Si encuentras una: repórtala", text: "Toma una foto, marca dónde la encontraste y cuéntanos cómo está. Si está herida, toca «Busquemos la veterinaria más cercana» y «Vamos» te lleva con Waze o Google Maps; allí también leen su microchip." },
  { title: "Ayuda y comparte", text: "Toca «La vi» si la ves, únete al grupo del caso, comparte la historia o el afiche. Cuando vuelva a casa, la familia te puede agradecer con la insignia «Ángel de patas»." },
];

const faqs = [
  { q: "¿PawFound es gratis?", a: "Sí, completamente: sin pagos, sin suscripciones y sin publicidad. Las Alertas Ángel también son gratis: llegan como notificación de la app, no como SMS." },
  { q: "¿Alguien puede ver dónde vivo?", a: "No. Los reportes, los avistamientos y tu ubicación para las alertas se guardan aproximados a una celda de 250 m y nunca se muestra tu dirección. La dirección exacta solo la compartes tú, si quieres, por mensaje directo: tu ubicación de ese momento o un punto de encuentro, nunca en vivo, y la puedes quitar cuando quieras." },
  { q: "¿Por qué no puedo bloquear a alguien?", a: "En PawFound nadie bloquea a nadie: si alguien es grosero o intenta estafar, lo reportas desde el mensaje o su perfil y el equipo de moderación lo revisa en menos de 24 horas." },
  { q: "¿Cuándo sale para iPhone?", a: "Primero lanzamos en Android para el Valle de Aburrá. La versión para iPhone llega después y funcionará igual." },
];
---

<Base
  title="PawFound · Que ninguna mascota se quede sin volver a casa"
  description="PawFound avisa a los vecinos que están cerca cuando una mascota se pierde y amplía la búsqueda a medida que pasan las horas. Gratis, para el Valle de Aburrá."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div>
        <p class="eyebrow"><Icon name="paw" /> Lanzamiento en el Valle de Aburrá</p>
        <h1 id="hero-title" style="margin-top:1rem">Que ninguna mascota se quede <em>sin volver a casa.</em></h1>
        <p class="lead">
          Cuando una mascota se pierde, PawFound avisa al instante a los vecinos que están cerca y, a medida que pasan las horas, amplía la
          búsqueda a más personas. Tú publicas en un minuto; la comunidad hace el resto.
        </p>
        <div class="badges-row">
          <span class="pill">🚨 Alerta Ángel</span>
          <span class="pill">⭕ Círculo de vida</span>
          <span class="pill">💬 Grupo por caso</span>
          <span class="pill">🔒 Sin dirección exacta</span>
        </div>
        <div id="descargar"><StoreButtons /></div>
        <p class="hero-note">Gratis y sin publicidad. Primero en Android; en iPhone, más adelante.</p>
      </div>
      <div class="stage" aria-hidden="true">
        <span class="ring"></span><span class="ring"></span><span class="ring"></span>
        <div class="phone"><Image src={home} alt="" widths={[290, 580]} sizes="290px" loading="eager" /></div>
        <div class="float-card fc-1">
          <span class="dot" style="background:var(--lost-soft);color:var(--lost)"><Icon name="bell" /></span>
          <span>🚨 Alerta Ángel<small>Max se perdió a 300 m de ti</small></span>
        </div>
        <div class="float-card fc-2">
          <span class="dot" style="background:var(--teal-soft);color:var(--teal)"><Icon name="home" /></span>
          <span>¡Ya está en casa!<small>Gracias por ayudar</small></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="como-funciona" aria-labelledby="como-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Cómo funciona</p>
        <h2 id="como-title">Tres pasos entre «se perdió» y «ya está en casa»</h2>
        <p class="lead">Ningún grupo de WhatsApp llega a tantas personas a la vez, en el lugar correcto y en el momento justo.</p>
      </div>
      <div class="steps">
        <article class="card step lost">
          <h3>Publicas en un minuto</h3>
          <p>Foto, señas y el último lugar donde la viste. Si la tenías en «Mis mascotas», el reporte ya está lleno.</p>
        </article>
        <article class="card step">
          <h3>Avisamos a quien está cerca</h3>
          <p>Le llega la Alerta Ángel a quienes están dentro de su círculo de vida, y a más personas a medida que el círculo crece.</p>
        </article>
        <article class="card step violet">
          <h3>La comunidad la encuentra</h3>
          <p>Avistamientos con «La vi», el grupo del caso, la historia y el afiche compartidos. Al reencontrarse, la familia agradece.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band-dark" id="circulo" aria-labelledby="circulo-title">
    <div class="wrap life">
      <div class="life-visual" aria-hidden="true">
        <span class="ring"></span><span class="ring"></span><span class="ring"></span>
        <span class="pin"><Icon name="paw" /></span>
        <span class="you">Tú</span>
      </div>
      <div>
        <p class="eyebrow" style="color:#7fe0cb">El círculo de vida</p>
        <h2 id="circulo-title" style="margin-top:0.6rem">La búsqueda crece al ritmo de la mascota</h2>
        <p class="lead" style="color:#b6c8d2;margin:1rem 0 1.5rem">
          Cada búsqueda arranca a 250 m del último lugar donde la vieron y en unos 30 minutos llega a 2 km: las primeras horas son las que
          más cuentan. Cuando el círculo llega a donde estás, te avisamos.
        </p>
        <div style="overflow-x:auto">
          <table>
            <thead><tr><th scope="col">Perfil</th><th scope="col">Al publicar</th><th scope="col">5 minutos</th><th scope="col">15 minutos</th><th scope="col">30 minutos</th></tr></thead>
            <tbody>
              {profiles.map((p) => <tr><td>{p.name}</td><td>{p.start}</td><td>{p.six}</td><td>{p.day}</td><td>{p.cap}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p style="margin-top:0.9rem;font-size:0.9rem">Radios aproximados. Si estás a menos de 250 m del reporte, la alerta te llega de inmediato.</p>
      </div>
    </div>
  </section>

  <section class="section" id="funciones" aria-labelledby="funciones-title">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">Todo lo que necesitas</p>
        <h2 id="funciones-title">Hecha para encontrar, no para scrollear</h2>
      </div>
      <div class="grid grid-4">
        {features.map((f) => (
          <article class="card">
            <span class={`icon ${f.tone}`}><Icon name={f.icon as "bell"} /></span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
      <div class="grid grid-3" style="margin-top:2.5rem" aria-label="Pantallas de la app">
        {[
          { src: alerta, alt: "Pantalla de Alerta Ángel con la foto de la mascota y el botón La vi" },
          { src: mapa, alt: "Mapa con mascotas perdidas y encontradas cerca y sus círculos de búsqueda" },
          { src: caso, alt: "Detalle de un caso con su círculo de vida y los avistamientos" },
        ].map((s) => (
          <div class="phone" style="margin:0 auto"><Image src={s.src} alt={s.alt} widths={[290, 580]} sizes="290px" /></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="tutorial" aria-labelledby="tutorial-title" style="background:var(--surface)">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Tutorial</p>
        <h2 id="tutorial-title">Tu primera vez en PawFound</h2>
        <p class="lead">Seis pasos, cinco minutos. Lo ideal es hacerlo hoy, antes de necesitarlo.</p>
      </div>
      <ol class="timeline">
        {tutorial.map((s, i) => (
          <li>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </li>
        ))}
      </ol>
      <p style="margin-top:1.5rem"><a class="btn btn-ghost" href="/guia">Ver la guía completa →</a></p>
    </div>
  </section>

  <section class="section" id="seguridad" aria-labelledby="seguridad-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Seguridad y convivencia</p>
        <h2 id="seguridad-title">Una comunidad en la que se puede confiar</h2>
      </div>
      <div class="grid grid-3">
        <article class="card"><span class="icon i-teal"><Icon name="shield" /></span><h3>Cuentas verificadas</h3><p>Para publicar o escribir hay que verificar el correo. Cada cuenta publica máximo 2 reportes al día.</p></article>
        <article class="card"><span class="icon i-lost"><Icon name="search" /></span><h3>Contra las estafas</h3><p>Detectamos fotos copiadas de otras publicaciones. Recuerda: nunca pagues por adelantado para recuperar a tu mascota.</p></article>
        <article class="card"><span class="icon i-violet"><Icon name="chat" /></span><h3>Sin bloqueos, con moderación</h3><p>Si alguien es grosero, lo reportas y una persona del equipo decide, con sanciones escalonadas.</p></article>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 id="faq-title">Lo que más nos preguntan</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
      <p style="margin-top:1.5rem"><a class="btn btn-ghost" href="/ayuda">Todas las preguntas y ayuda →</a></p>
    </div>
  </section>

  <section class="section band-teal" aria-labelledby="cta-title">
    <div class="wrap center" style="display:grid;gap:1.25rem;justify-items:center">
      <h2 id="cta-title">Prepárate hoy. Ayuda mañana.</h2>
      <p class="lead center" style="color:#d8f1eb">Descarga PawFound cuando salga, agrega a tus mascotas y activa las alertas. Así, el día que alguien las necesite, estarás ahí.</p>
      <StoreButtons />
    </div>
  </section>
</Base>
